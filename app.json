{
  "expo": {
    "name": "vinyl-vault",
    "slug": "vinyl-vault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/vinilLogo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/vinilLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/vinilLogo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.vinylvault"
    },
    "web": {
      "favicon": "./assets/vinilLogo.png"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
